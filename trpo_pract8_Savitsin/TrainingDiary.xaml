<Page x:Class="trpo_pract8_Savitsin.TrainingDiary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo_pract8_Savitsin"
      xmlns:converters="clr-namespace:trpo_pract8_Savitsin.Converters"      
      mc:Ignorable="d" 
      Background="#F5F5F5"
      d:DesignHeight="450" d:DesignWidth="950"
      Title="TrainingDiary">

    <Page.Resources>
        <converters:MinutesToHoursConverter x:Key="minutesToHoursConverter"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF7F50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
        </Style>
    </Page.Resources>
    
    <DockPanel>
        <Grid DockPanel.Dock="Left">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="70" MaxHeight="100"/>
                <RowDefinition Height="Auto" MinHeight="200" MaxHeight="400"/>
                <RowDefinition Height="Auto" MinHeight="60" MaxHeight="100"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="5">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="24" Foreground="#2A4D9B" Text="Тренировочный дневник"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="btnRecord_Click" Margin="5,0" FontSize="16" Content="Записать тренировку"/>
                    <Button Click="btnEdit_Click" Margin="5,0" FontSize="16" Content="Изменить тренировку"/>
                    <Button Click="btnDelete_Click" Margin="5,0,0,0" FontSize="16" Content="Удалить тренировку"/>
                </StackPanel>
            </DockPanel>

            <ListView Grid.Row="1" Margin="5"
                  Background="#F5F5F5"
                  BorderBrush="#2A4D9B"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding TrainingList}"
                  SelectedItem="{Binding SelectedTraining}">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#2A4D9B" BorderThickness="1" Padding="8" Margin="2" Background="#F5F5F5">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock FontSize="18" Foreground="#2A4D9B" Text="{Binding TrainingType}"/>
                                    <TextBlock FontSize="14" Text="{Binding WorkLoad}"/>
                                    <TextBlock FontSize="14" Text="{Binding Description}"/>
                                </StackPanel>

                                <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <TextBlock FontSize="14" HorizontalAlignment="Right" Text="{Binding TrainingDate, StringFormat=dd.MM.yyyy}"/>
                                    <TextBlock FontSize="14" HorizontalAlignment="Right" Foreground="#2A4D9B" Text="{Binding Duration, Converter={StaticResource minutesToHoursConverter}}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="2" Margin="5" Background="#2A4D9B" Padding="8,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="16" Foreground="White" Text="Записано тренировок: "/>
                    <TextBlock FontSize="16" Foreground="White" Text="{Binding TrainingList.Count}"/>
                </StackPanel>
            </Border>

        </Grid>
    </DockPanel>
</Page>
